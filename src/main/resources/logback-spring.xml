<?xml version="1.0" encoding="UTF-8"?>
<!--
  observability.md §3: JSON to stdout, never a file the application manages. Same shape as
  turnbase-platform's encoder — timestamp/level/service/logger/thread/message plus whichever
  correlation IDs and traceId/spanId are in the MDC, absent ones omitted rather than null
  (IMP-GATE-19).
-->
<configuration>
  <springProperty scope="context" name="serviceName" source="spring.application.name"/>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <!-- Otherwise every Logback context property (springProperty included) leaks in as its
           own top-level field — "serviceName" alongside "service", not in the doc's schema. -->
      <includeContext>false</includeContext>
      <fieldNames>
        <timestamp>timestamp</timestamp>
        <logger>logger</logger>
        <thread>thread</thread>
        <message>message</message>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
      <customFields>{"service":"${serviceName}"}</customFields>
      <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</timestampPattern>
      <timeZone>UTC</timeZone>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
